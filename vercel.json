{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm i -g pnpm@11.5.2 && pnpm --dir viewer install --frozen-lockfile",
  "buildCommand": "pnpm --dir viewer build:public",
  "outputDirectory": "viewer/dist-public",
  "headers": [
    {
      "source": "/(glb|stills)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }]
    }
  ]
}
